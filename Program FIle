#include <Wire.h>
#include <RTClib.h>

RTC_DS3231 rtc;

// Define pins for LEDs
const int hourPins[4] = {2, 3, 4, 5};     // Pins for hour LEDs
const int minutePins[6] = {6, 7, 8, 9, 10, 11}; // Pins for minute LEDs
const int secondPins[6] = {12, 13, A0, A1, A2, A3}; // Pins for second LEDs

void setup() {
  Serial.begin(9600);
  Wire.begin();

  // Initialize RTC module
  if (!rtc.begin()) {
    Serial.println("Couldn't find RTC");
    while (1);
  }

  // Set up LED pins as output
  for (int i = 0; i < 4; i++) {
    pinMode(hourPins[i], OUTPUT);
  }
  for (int i = 0; i < 6; i++) {
    pinMode(minutePins[i], OUTPUT);
    pinMode(secondPins[i], OUTPUT);
  }
}

void loop() {
  DateTime now = rtc.now(); // Get current time
  
  // Display hours, minutes, and seconds
  displayBinary(now.hour(), hourPins, 4);
  displayBinary(now.minute(), minutePins, 6);
  displayBinary(now.second(), secondPins, 6);

  delay(1000); // Update every second
}

void displayBinary(int value, const int pins[], int numBits) {
  for (int i = 0; i < numBits; i++) {
    if (value & (1 << i)) { // Check if the i-th bit is 1
      digitalWrite(pins[i], HIGH); // Turn on LED
    } else {
      digitalWrite(pins[i], LOW); // Turn off LED
    }
  }
}
